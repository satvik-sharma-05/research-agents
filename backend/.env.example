# OpenRouter API Key (for LLM - using LLaMA-3)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Tavily API Key (for web search)
# Get your key from: https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Optional: News API Key (for news search)
NEWS_API_KEY=your_news_api_key_here

# Database URL (defaults to SQLite if not set)
# For local development: sqlite:///./research.db
# For PostgreSQL on Render: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/database

